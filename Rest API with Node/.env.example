PORT=3000
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
# Hosted PostgreSQL connection URL (e.g. from Render Postgres, Railway Postgres, Neon, Supabase)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname
# Allowed frontend domain for CORS (e.g., https://taskflow-app.vercel.app)
CLIENT_URL=https://your-frontend.vercel.app
